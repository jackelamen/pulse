# Supabase — shared with TheEDGEx
NEXT_PUBLIC_SUPABASE_URL=https://mdkyijbgvxedelcqcouu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cookie scope for cross-subdomain auth on production.
# Leave unset for localhost dev. Set to ".theedgex.com" in production
# so login on theedgex.com is honored at tasks.theedgex.com.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Web Push (VAPID) — required for reminders / push notifications.
# Generate a key pair once with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is sent to the browser for subscription.
# VAPID_PRIVATE_KEY is server-only (never expose it client-side).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jack@theedgex.com

# Google Calendar one-way sync (Pulse -> Google).
# From the OAuth "web application" client JSON in Google Cloud Console.
# Both are server-only — never expose the secret to the browser.
# The same two values must also be set as Edge Function secrets for
# the push-to-google function (supabase secrets set GOOGLE_CLIENT_ID=... etc).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
